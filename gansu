<!DOCTYPE html> <html lang="zh-CN"> <head> <meta charset="utf-8" /> <meta name="viewport" content="width=device-width, initial-scale=1" /> <title>甘肃六日自助旅行手册（初稿，离线可用）</title> <style> :root { --bg: #0f111a; --card: #1b1f2b; --text: #e8e8e8; --muted: #a6a6a6; --accent: #2bd77f; --danger: #ff6b6b; --green: #34c759; --blue: #4ea8ff; --start: #ffd166; --end: #06d6a0; } @media (prefers-color-scheme: light) { :root { --bg: #f6f7fb; --card: #ffffff; --text: #0a0a0a; --muted: #555; } }

html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text); font-family: system-ui, -apple-system, "PingFang SC", "Noto Sans CJK SC", sans-serif; line-height: 1.4; } .container { max-width: 980px; margin: 0 auto; padding: 12px 12px 40px; } .card { background: var(--card); border-radius: 12px; padding: 14px 16px; box-shadow: 0 1px 0 rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); margin-bottom: 14px; } h2 { margin: 0 0 8px; font-size: 16px; color: #9be8ff; } .row { display: flex; gap: 12px; flex-wrap: wrap; } .col { flex: 1 1 0; min-width: 260px; }

/* 顶部此刻关注卡片 */ #nowCard { display: grid; grid-template-columns: 1fr; align-items: start; gap: 12px; } .countdown { font-weight: 700; font-size: 28px; letter-spacing: 1px; } .sub { color: var(--muted); font-size: 12.5px; } .todoTop { display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; border-radius: 8px; background: rgba(91, 235, 194, 0.08); border: 1px solid rgba(43,215,127,.25); }

/* 行程总览地图（手绘风格 SVG 占位） / .svgMap { width: 100%; height: auto; display: block; overflow: visible; } / 日程列表与待办 */ .dayItem { display: grid; grid-template-columns: 88px 1fr; gap: 12px; align-items: start; } .dateTag { font-weight: 700; color: #0bd; text-align: right; padding-top: 6px; } .dayContent { padding: 10px 12px; background: rgba(255,255,255,.04); border-radius: 8px; border: 1px solid rgba(255,255,255,.08); } .tag { display: inline-block; padding: 2px 6px; border-radius: 999px; font-size: 11px; background: #1b1f2b; color: #9be8ff; border: 1px solid rgba(155,232,255,.3); margin-left: 8px; }

.slot { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 12px; background: rgba(43,214,127,.15); color: #9affd6; border: 1px solid rgba(43,214,127,.3); margin-left: 6px; }

.badge { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 12px; background: rgba(0,0,0,.15); color: #fff; margin-left: 6px; }

/* 待办清单（前端渲染，离线可用） */ #todoList { display: grid; gap: 8px; } .todoItem { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 6px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); } .checkbox { width: 18px; height: 18px; border: 2px solid #9be8ff; border-radius: 4px; display: inline-block; vertical-align: middle; cursor: pointer; } .checkbox.checked { background: #2bd77f; border-color: #2bd77f; } .todoTitle { flex: 1; font-size: 14px; }

/* 页脚提示/小工具 */ .tip { font-size: 12.5px; color: var(--muted); }

/* 链接按钮样式（导航、地图跳转等） */ a.navLink { color: #9be8ff; text-decoration: none; border-bottom: 1px dotted rgba(155,232,255,.5); }

/* 小工具：导航链接按钮 */ .navRow { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }

@media (max-width: 720px) { .dayItem { grid-template-columns: 76px 1fr; } } </style> </head> <body> <div class="container"> <!-- 顶部此刻关注卡片 --> <section class="card" id="nowCard" aria-label="此刻关注"> <div style="display:flex; justify-content:space-between; align-items:center;"> <h2>此刻关注</h2> <div class="badge" id="peopleBadge" aria-label="同行人数">3 人</div> </div> <div class="row" style="align-items:stretch;"> <div class="col" style="flex:1;"> <div class="countdown" id="countdown">倒计时：加载中…</div> <div class="sub">下一个行程事件</div> </div> </div> <div class="todoTop" aria-label="当前待办清单第一条"> <span style="font-weight:600;">当前待办</span> <span id="topTodo" class="slot" title="第一条待办项"></span> </div> </section>

<!-- 行程总览地图（手绘风格 SVG 占位） --> <section class="card" aria-label="行程总览地图"> <h2>行程总览地图（按天着色）</h2> <svg class="svgMap" viewBox="0 0 900 320" role="img" aria-label="手绘风格的行程地图占位"> <!-- 背景网格与日程刻度（简单占位） --> <defs> <linearGradient id="grad" x1="0" y1="0" x2="1" y2="0"> <stop offset="0%" stop-color="#ffd166"/> <stop offset="100%" stop-color="#06d6a0"/> </linearGradient> </defs> <rect x="0" y="0" width="900" height="320" fill="#1a1c22"/> <!-- 天数分段颜色（D1-D6） --> <g fill="none" stroke-width="8"> <path d="M60,260 C180,180 260,120 360,120" stroke="#ffd166"/> <path d="M420,260 C520,180 620,150 700,120" stroke="#2ec4b6" /> <path d="M720,260 C780,210 820,180 840,140" stroke="#62a1ff" /> </g> <!-- 标注各晚住宿城市（占位） --> <g fill="#fff" font-family="monospace" font-size="12"> <text x="70" y="250" fill="#ffd166">敦煌</text> <text x="230" y="195" fill="#2ec4b6">嘉峪关</text> <text x="520" y="170" fill="#62a1ff">武威</text> <text x="660" y="140" fill="#a8e6a0">兰州</text> <text x="860" y="120" fill="#9be8ff">杭州/仙居</text> </g> <!-- 简易路线点 --> <circle cx="60" cy="260" r="6" fill="#ffd166"/> <circle cx="200" cy="200" r="6" fill="#2ec4b6"/> <circle cx="520" cy="170" r="6" fill="#62a1ff"/> <circle cx="660" cy="140" r="6" fill="#a8e6a0"/> <circle cx="860" cy="120" r="6" fill="#9be8ff"/> </svg> </section>

<!-- 已确认的票务/住宿卡片（占位） --> <section class="card" aria-label="已确认的机票/酒店/门票卡片（占位）"> <h2>已确认的票务与住宿</h2> <div class="row"> <div class="col card" style="padding:10px;"> <strong>航班</strong> <div>D1: 9/14 杭州萧山 T4 → 敦煌莫高 (CA1757) 未使用</div> </div> <div class="col card" style="padding:10px;"> <strong>航班</strong> <div>D6: 9/19 兰州中川 T3 → 杭州萧山 T3 未使用</div> </div> <div class="col card" style="padding:10px;"> <strong>住宿（占位）</strong> <div>敦煌占位酒店 • 嘉峪关占位酒店 • 武威占位酒店 • 兰州占位酒店</div> </div> </div> <div class="tip" style="margin-top:8px;">注：酒店名称将在你提供具体信息后替换为实际名称。</div> </section>

<!-- 逐日行程 --> <section class="card" aria-label="逐日行程（D1–D6）"> <h2>逐日行程</h2> <div id="days" class="row" style="flex-direction:column; gap:14px;"> <!-- D1 --> <div class="dayItem" data-day="D1"> <div class="dateTag">D1</div> <div class="dayContent"> <div><strong>杭州 → 敦煌</strong> <span class="tag" title="航班确认后该项可点击跳转导航">航班待定</span></div> <div class="tip" style="margin-top:6px;">需提前订票的景点：无，抵达后安排自由活动</div> </div> </div> <!-- D2 --> <div class="dayItem" data-day="D2"> <div class="dateTag">D2</div> <div class="dayContent"> <div><strong>敦煌：莫高窟/鸣沙山</strong> <span class="slot" title="需要提前订票">需订票</span></div> <div class="tip" style="margin-top:6px;">距离敦煌市区较近，建议上午莫高窟，下午鸣沙山日落/沙坡头自选</div> </div> </div> <!-- D3 --> <div class="dayItem" data-day="D3"> <div class="dateTag">D3</div> <div class="dayContent"> <div><strong>敦煌博物馆 → 嘉峪关城楼</strong> <span class="slot" title="车程约 5 小时">车程约 5h</span></div> <div class="tip" style="margin-top:6px;">路线：敦煌出发，驾车或包车前往嘉峪关</div> </div> </div> <!-- D4 --> <div class="dayItem" data-day="D4"> <div class="dateTag">D4</div> <div class="dayContent"> <div><strong>嘉峪关 → 张掖七彩丹霞 → 武威</strong> <span class="slot" title="车程信息">车程约 2.5h + 3.5h</span></div> </div> </div> <!-- D5 --> <div class="dayItem" data-day="D5"> <div class="dateTag">D5</div> <div class="dayContent"> <div><strong>武威 → 鸿摩罗什寺 → 天梯山石窟 → 兰州</strong> <span class="slot" title="车程信息">约 4h+1h+4h</span></div> </div> </div> <!-- D6 --> <div class="dayItem" data-day="D6"> <div class="dateTag">D6</div> <div class="dayContent"> <div><strong>兰州 → 杭州 → 仙居</strong> <span class="slot" title="航班/车次信息">航班/动车待定</span></div> </div> </div> </div> </section>

<!-- 待办清单（多用户同步需要服务端，当前为前端离线渲染，后续可接后端同步） --> <section class="card" aria-label="待办清单（离线渲染，初稿）"> <h2>待办清单（离线渲染，可在本地勾选，若需要多人同步，请后续接入服务端）</h2> <div id="todoList"> <div class="todoItem" data-id="t1"> <span class="checkbox" role="checkbox" aria-label="完成该待办"></span> <span class="todoTitle">确认动车票（兰州/武威段）时间与座位</span> </div> <div class="todoItem" data-id="t2"> <span class="checkbox" role="checkbox" aria-label="完成该待办"></span> <span class="todoTitle">酒店名称与房型占位替换为实际信息</span> </div> <div class="todoItem" data-id="t3"> <span class="checkbox" role="checkbox" aria-label="完成该待办"></span> <span class="todoTitle">确保航班票面时间作为日程锚点（若有变动需重新排程）</span> </div> </div> </section>

<!-- 实用贴士 --> <section class="card" aria-label="实用贴士"> <h2>实用贴士</h2> <ul class="tip" style="margin:0; padding-left:1.2rem;"> <li>地点点击可唤起百度地图导航跳转；手机端打开即可导航达成。</li> <li>每日路线地图可展开查看全天点位导航（占位，后续可扩展为完整数据）。</li> <li>白天/夜间自动换配色，便于夜间查看与省电。</li> <li>公开网页不包含敏感信息（如确认号、证件号、房间号等）。</li> </ul> </section>

</div>

<script> // 简易倒计时：设定下一个事件的目标日期时间（示例占位，实际以你的具体日期替换） // 由于你已经给出航班/日期信息，当前初稿用固定目标(2026-09-14T13:00:00)演示 const target = new Date("2026-09-14T13:00:00+08:00"); const countdownEl = document.getElementById("countdown"); function updateCountdown() { const now = new Date(); const diff = target - now; if (diff <= 0) { countdownEl.textContent = "此刻关注：已开始或结束"; return; } const d = Math.floor(diff / (1000 * 60 * 60 * 24)); const h = Math.floor((diff / (1000 * 60 * 60)) % 24); const m = Math.floor((diff / (1000 * 60)) % 60); const s = Math.floor((diff / 1000) % 60); countdownEl.textContent = 下一个行程事件还剩 ${d}d ${h}h ${m}m ${s}s; } updateCountdown(); setInterval(updateCountdown, 1000);

// 待办勾选本地保存（简单在本设备本地生效） const items = document.querySelectorAll(".todoItem"); items.forEach(it => { it.addEventListener("click", () => { const box = it.querySelector(".checkbox"); const isChecked = box.classList.toggle("checked"); // 保存状态在 localStorage const id = it.dataset.id; localStorage.setItem("todo_" + id, isChecked ? "1" : "0"); }); // 初始化状态 const id = it.dataset.id; const saved = localStorage.getItem("todo_" + id); if (saved === "1") { it.querySelector(".checkbox").classList.add("checked"); } }); </script> </body> </html>
